# Copy to .env and fill in.

# Your Anthropic API key — with this set, Claude designs every winning build.
# Without it, the server runs in mock-designer mode (still fully functional).
ANTHROPIC_API_KEY=

# Model used by the build crew (cheap + fast is right for this job)
ANTHROPIC_MODEL=claude-haiku-5-5

# Votes a suggestion needs before the crew picks it up
MIN_VOTES=5

# How long the crew "constructs" each build, in seconds
BUILD_SECONDS=60

# How long a token's bonding curve takes to fill, in seconds (simulated)
CURVE_SECONDS=600

# ---------- Solana (mainnet via Helius) ----------

# Your Helius API key (dashboard.helius.dev). With this set, the server connects
# to Solana mainnet, the site shows live chain status, and the launch path is
# RPC-ready. The key stays server-side; it never reaches the browser.
HELIUS_API_KEY=

# Or override with a full RPC URL instead of the key above:
# SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=...
# SOLANA_CLUSTER=mainnet-beta

# On-chain launches — run `npm run chain:setup` and it fills these in:
# LAUNCHER_KEYPAIR=.keys/launcher.json   # treasury/mint keypair (setup generates it)
# ENABLE_ONCHAIN_LAUNCH=true             # THE arm switch: with it true + a funded
#                                        # launcher, every shipped $TICKER mints a
#                                        # real Token-2022 token automatically
# TOKEN_METADATA_URI=                    # optional: hosted metadata JSON for mints
# LAUNCHPAD_PROGRAM=                     # your deployed Anchor bonding-curve program
#                                        # (curve is simulated until this is set)

# Where the JSON store lives (mount a persistent disk here in production)
# DATA_DIR=/data

# PORT=3000

# Code builds: when true (default), Claude can ship interactive mini-apps for
# winning suggestions. They run in a locked iframe sandbox (no network, no
# access to the site, cookies or other pages). Set false for content-only.
# ENABLE_CODE_BUILDS=true

# Owner kill switch for voted site mods:
#   curl -X DELETE "https://yoursite/api/mods/<id>?key=YOUR_ADMIN_KEY"
# ADMIN_KEY=choose-a-long-random-string

# ---------- Real launches: Raydium LaunchLab (default backend) ----------
# When armed, each shipped $TICKER creates its token + a REAL bonding curve on
# Raydium's LaunchLab program: trading opens on raydium.io instantly and the
# pool auto-migrates to a Raydium AMM at full raise.
# LAUNCH_BACKEND=raydium     # or "token2022" for mint-only (no curve)
# DEV_BUY_SOL=0              # optional creator first-buy per launch, in SOL
# Costs ~0.03-0.05 SOL per launch from the launcher wallet.

# Your site's public URL — enables self-hosted token metadata (name+image in
# wallets/explorers) and is shown on your LaunchLab platform profile.
# PUBLIC_URL=https://buildpad.yourdomain.com

# Platform fee share (run `npm run chain:platform` once to register):
# PLATFORM_FEE_BPS=100        # 100 bps = 1% of every curve trade to Buildpad
# PLATFORM_NAME=Buildpad
# PLATFORM_ID=                # written automatically by chain:platform
